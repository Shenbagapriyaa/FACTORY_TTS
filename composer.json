{
  "name": "textile/production-management",
  "type": "project",
  "description": "Textile Production Management - Fabric, Fabric Group and Lay Model module",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.10"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "setup": ["@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"", "@php artisan migrate --seed"],
    "dev": ["Composer\\Config::disableProcessTimeout", "php artisan serve"]
  },
  "extra": {"laravel": {"dont-discover": []}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
